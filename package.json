{
  "name": "coursewright",
  "private": true,
  "version": "0.1.0",
  "description": "Coursewright: a personal course learner. Interview, generated courses, Notion-style notes and a RAG tutor.",
  "type": "module",
  "author": "Shivaraj Bakale",
  "dependencies": {
    "@ag-ui/client": "^1.0.3",
    "@copilotkit/core": "^1.84.1",
    "@copilotkit/react-core": "^1.84.1",
    "@copilotkit/runtime": "^1.84.1",
    "@hookform/resolvers": "^4.1.3",
    "@mantine/carousel": "^9.6.0",
    "@mantine/charts": "^9.6.0",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/modals": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@mantine/spotlight": "^9.6.0",
    "@shivarajbakale/blocks": "file:vendor/kit/shivarajbakale-blocks-0.1.0.tgz",
    "@shivarajbakale/grid": "file:vendor/kit/shivarajbakale-grid-0.2.0.tgz",
    "@shivarajbakale/theme": "file:vendor/kit/shivarajbakale-theme-0.1.0.tgz",
    "@shivarajbakale/ui": "file:vendor/kit/shivarajbakale-ui-0.0.0.tgz",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.62.18",
    "@tanstack/react-router": "^1.114.17",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.8.4",
    "dayjs": "^1.11.23",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.482.0",
    "mermaid": "^12.3.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "react-native-web": "^0.21.4",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^3.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tanstack/react-query-devtools": "^5.62.18",
    "@tanstack/react-router-devtools": "^1.114.21",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.0.8",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.0.0",
    "msw": "^2.11.5",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "^1.62.1",
    "postcss-loader": "^8.1.1",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.5.3",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.10",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "vite": "^8.2.2",
    "vitest": "^3.0.8",
    "vitest-axe": "^0.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:mobile",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "ui-lint": "node scripts/ui-lint.mjs",
    "capability-lint": "node scripts/capability-lint.mjs",
    "doc-links": "node scripts/doc-links.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "browsers": "playwright install chromium",
    "ui-probe": "npm run browsers && vitest run --config vitest.ui-probe.config.ts",
    "test:coverage": "vitest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook-lint": "node scripts/storybook-lint.mjs",
    "skill-lint": "node scripts/skill-lint.mjs",
    "storybook-render": "npm run browsers && node scripts/storybook-render.mjs --build",
    "storybook-docs": "node scripts/gen-storybook-docs.mjs",
    "feature-plan": "node scripts/feature-plan.mjs",
    "plan-lint": "node scripts/plan-lint.mjs",
    "doc-lint": "node scripts/doc-lint.mjs --strict",
    "loop-lint": "node scripts/loop-lint.mjs --strict",
    "runtime": "tsx runtime-dev/server.ts",
    "agent": "cd agent && uv run uvicorn app.main:app --port 8123 --reload --timeout-graceful-shutdown 3",
    "dev:stack": "bash scripts/dev-stack.sh",
    "deploy": "bash deploy/deploy.sh",
    "deploy:status": "bash deploy/deploy.sh --status",
    "deploy:logs": "bash deploy/deploy.sh --logs",
    "deploy:down": "bash deploy/deploy.sh --down",
    "dev:mobile": "vite -c vite.mobile.config.ts",
    "build:mobile": "vite build -c vite.mobile.config.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivarajbakale/coursewright.git"
  }
}
