# Mock Service Worker (MSW)
# Enabled by default so the app boots with realistic mock data and NO backend.
# Set to 'false' to talk to a real API (configure VITE_API_URL below).
VITE_ENABLE_MOCKING=true

# API base URL (only used when mocking is off).
# In dev, the Vite proxy forwards /api/* to this target.
# VITE_API_URL=http://localhost:3000

# Auto-login in development.
# When true (or unset), the app boots straight into the dashboard with a demo
# session. Set to 'false' to require a manual sign-in on every fresh load.
# VITE_AUTO_LOGIN=true
