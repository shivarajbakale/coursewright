# Copy to agent/.env and fill in what you have. Only ANTHROPIC_API_KEY is needed to build courses
# and talk to the tutor; reading, notes and search work without any key.

# Claude (https://console.anthropic.com). Or any Anthropic-compatible provider, see below.
ANTHROPIC_API_KEY=

# Optional: an Anthropic-compatible provider instead of Claude, e.g. MiniMax:
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# CW_MODEL=MiniMax-M3

# Optional: better retrieval (Voyage embeddings). Without it a local hashed embedder is used.
# VOYAGE_API_KEY=

# Optional: let project reviews read private GitHub repos.
# GITHUB_TOKEN=

# Optional: tokens after which a build stops polishing and saves the course as written.
# CW_BUILD_TOKEN_BUDGET=4000000
