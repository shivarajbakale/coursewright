# Deploy settings for deploy/deploy.sh. Plain KEY=value, sourced by bash.

# Tailscale node name: the app lives at https://<NODE_NAME>.<TAILNET>
NODE_NAME=coursewright

# Port the served service listens on inside its container (nginx in the web service).
SERVE_PORT=8080

# Tailnet suffix, only used to print the URL.
TAILNET="${TAILNET:-}"  # your tailnet suffix (e.g. tailXXXX.ts.net), from the environment; only used to print the URL

# Paths that must return 200 after a deploy: the app, and the agent service through nginx.
HEALTH_PATHS="/ /api/health"

# Compose file ts-deploy reads, and where the project lands on the host ($HOME-relative).
COMPOSE_FILE=compose.ts-deploy.yml
REMOTE_DIR=projects/coursewright

# Not needed to build the images. agent/.env IS synced: it carries the model key (bring your own key).
RSYNC_EXCLUDES="docs .memsearch storybook-static agent/.venv agent/data agent/evals/results .ui-probe"

# Printed before a public deploy.
PUBLIC_WARNING="Do not. Coursewright has no login of its own and every course build spends the model key in agent/.env; only the tailnet keeps it private."
